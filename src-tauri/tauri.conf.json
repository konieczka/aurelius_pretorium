{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pretorium",
  "version": "0.2.6",
  "identifier": "com.michalkonieczka.pretorium",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Pretorium",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Command a fleet of coding agents",
    "copyright": "© 2026 Michał Konieczka",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4MDgyMzMzQTIxMEM3NjAKUldSZ3h4Q2lNeU1JZUNxMWZBZEhFN3BDd0tKYTUwbk11Y1U2QTZHSkRZdFZjUnBZOWdXMlhNUzkK",
      "endpoints": [
        "https://github.com/konieczka/aurelius_pretorium/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
